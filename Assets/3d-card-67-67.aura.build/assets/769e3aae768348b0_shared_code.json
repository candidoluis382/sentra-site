[{"id":12251,"slug":"3d-card-67-67","title":"3D Card Banking Landing Page Template","code":"<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n<script>\ntry{if(window.parent&&window.parent!==window){window.parent.promotekit_referral=\"1fd2949a-d22c-431b-92bf-02d4ad04ee24\";window.parent.document.cookie=\"promotekit_referral=1fd2949a-d22c-431b-92bf-02d4ad04ee24;path=/;domain=.aura.build;max-age=31536000\"}}catch(e){}\n</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Nova - Next Generation Banking</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script src=\"https://code.iconify.design/3/3.1.0/iconify.min.js\"></script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\nbody {\nfont-family: 'Inter', sans-serif;\nbackground-color: #09090b; /* Zinc 950 */\nbackground-image: radial-gradient(circle at 50% 0%, #18181b 0%, #09090b 100%);\ncolor: #ffffff;\noverflow-x: hidden;\n}\n/* 3D Card Specific Styles */\n.card-container {\nperspective: 1200px;\n}\n.card-3d {\ntransform-style: preserve-3d;\ntransform: rotateX(10deg) rotateY(15deg) rotateZ(-2deg);\n}\n.layer-depth-1 { transform: translateZ(-1px); }\n.layer-depth-2 { transform: translateZ(-2px); }\n.layer-depth-3 { transform: translateZ(-3px); }\n.layer-depth-4 { transform: translateZ(-4px); }\n.layer-depth-5 { transform: translateZ(-5px); }\n.epic-gradient {\nbackground:\nradial-gradient(at 0% 0%, rgba(99, 102, 241, 0.5) 0px, transparent 50%),\nradial-gradient(at 100% 0%, rgba(236, 72, 153, 0.5) 0px, transparent 50%),\nradial-gradient(at 100% 100%, rgba(34, 197, 94, 0.3) 0px, transparent 50%),\nradial-gradient(at 0% 100%, rgba(168, 85, 247, 0.5) 0px, transparent 50%),\nlinear-gradient(135deg, #1e1b4b, #312e81);\nbackground-size: 200% 200%;\nanimation: shimmer 15s ease infinite alternate;\n}\n@keyframes shimmer {\n0% { background-position: 0% 50%; }\n50% { background-position: 100% 50%; }\n100% { background-position: 0% 50%; }\n}\n.glass-panel {\nbackground: rgba(255, 255, 255, 0.05);\nbackdrop-filter: blur(2px);\nborder-top: 1px solid rgba(255, 255, 255, 0.2);\nborder-left: 1px solid rgba(255, 255, 255, 0.1);\nbox-shadow:\ninset 0 0 30px rgba(255,255,255,0.05),\n0 20px 50px rgba(0,0,0,0.5);\n}\n.chip {\nbackground: linear-gradient(135deg, #e2e2e2 0%, #a1a1aa 50%, #e2e2e2 100%);\n}\n.font-mono-card {\nfont-family: 'JetBrains Mono', monospace;\n}\n/* Initial Hero Animations */\n.fade-in-up {\nanimation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\nopacity: 0;\ntransform: translateY(20px);\n}\n.delay-100 { animation-delay: 0.1s; }\n.delay-200 { animation-delay: 0.2s; }\n.delay-300 { animation-delay: 0.3s; }\n@keyframes fadeInUp {\nfrom { opacity: 0; transform: translateY(20px); }\nto { opacity: 1; transform: translateY(0); }\n}\n/* Scroll Animations */\n.reveal-on-scroll {\nopacity: 0;\ntransform: translateY(30px);\ntransition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.reveal-on-scroll.is-visible {\nopacity: 1;\ntransform: translateY(0);\n}\n/* Staggered delays for grid items */\n.stagger-1 { transition-delay: 100ms; }\n.stagger-2 { transition-delay: 200ms; }\n.stagger-3 { transition-delay: 300ms; }\n/* Button & Interactive Animations */\n.btn-shine {\nposition: relative;\noverflow: hidden;\n}\n.btn-shine::after {\ncontent: '';\nposition: absolute;\ntop: 0;\nleft: -100%;\nwidth: 50%;\nheight: 100%;\nbackground: linear-gradient(\nto right,\ntransparent,\nrgba(255, 255, 255, 0.3),\ntransparent\n);\ntransform: skewX(-20deg);\ntransition: 0.5s;\npointer-events: none;\n}\n.btn-shine:hover::after {\nleft: 150%;\ntransition: 0.7s ease-in-out;\n}\n.btn-bounce {\ntransition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n.btn-bounce:active {\ntransform: scale(0.95);\n}\n/* Subtle grid background */\n.bg-grid {\nbackground-size: 40px 40px;\nbackground-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),\nlinear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\nmask-image: radial-gradient(circle at center, black 40%, transparent 100%);\n}\n/* Pricing highlight */\n.pricing-glow {\nposition: absolute;\ninset: -1px;\nbackground: linear-gradient(to bottom, rgba(99, 102, 241, 0.5), rgba(0,0,0,0));\nborder-radius: 1.5rem;\nz-index: -1;\nopacity: 0.5;\ntransition: opacity 0.3s ease;\n}\n.group:hover .pricing-glow {\nopacity: 0.8;\n}\n</style></head>\n<body class=\"min-h-screen flex flex-col antialiased selection:bg-indigo-500/30 text-zinc-300\">\n\n    <!-- Ambient Glows -->\n    <div class=\"fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-indigo-600/10 rounded-full blur-[120px] -z-10 pointer-events-none\"></div>\n    <div class=\"fixed bottom-0 right-0 w-[500px] h-[500px] bg-fuchsia-600/5 rounded-full blur-[100px] -z-10 pointer-events-none\"></div>\n\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 w-full z-50 border-b border-white/5 bg-black/50 backdrop-blur-md transition-all duration-300\" id=\"navbar\">\n        <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2 text-white cursor-pointer group\">\n                <div class=\"w-6 h-6 rounded bg-gradient-to-tr from-indigo-500 to-fuchsia-500 flex items-center justify-center text-[10px] font-bold shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300\">N</div>\n                <span class=\"font-medium tracking-tight text-sm group-hover:text-indigo-200 transition-colors\">Nova Financial</span>\n            </div>\n            \n            <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400\">\n                <a href=\"#\" class=\"hover:text-white transition-colors duration-200 relative group\">\n                    Products\n                    <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-indigo-500 transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n                <a href=\"#\" class=\"hover:text-white transition-colors duration-200 relative group\">\n                    Solutions\n                    <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-indigo-500 transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n                <a href=\"#\" class=\"hover:text-white transition-colors duration-200 relative group\">\n                    Developers\n                    <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-indigo-500 transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n                <a href=\"#\" class=\"hover:text-white transition-colors duration-200 relative group\">\n                    Pricing\n                    <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-indigo-500 transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n            </div>\n\n            <div class=\"flex items-center gap-4\">\n                <a href=\"#\" class=\"hidden sm:block text-xs font-medium text-zinc-400 hover:text-white transition-colors\">Sign In</a>\n                <a href=\"#\" class=\"btn-shine btn-bounce text-xs font-medium bg-white text-black px-4 py-2 rounded-full hover:bg-zinc-200 transition-colors\">Get Started</a>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <main class=\"flex-grow pt-32 relative\">\n        <div class=\"absolute inset-0 bg-grid -z-20 pointer-events-none\"></div>\n        \n        <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n            \n            <!-- Left Column: Copy -->\n            <div class=\"space-y-8 relative z-20\">\n                <div class=\"fade-in-up\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 text-[10px] uppercase tracking-wider font-medium text-indigo-300 hover:bg-white/10 transition-colors cursor-default\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse\"></span>\n                        New v2.0 Released\n                    </div>\n                </div>\n\n                <h1 class=\"fade-in-up delay-100 text-5xl sm:text-6xl font-semibold tracking-tight text-white leading-[1.1]\">\n                    Banking built for <br />\n                    <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-white to-zinc-400 animate-gradient-x\">modern founders.</span>\n                </h1>\n                \n                <p class=\"fade-in-up delay-200 text-lg text-zinc-400 max-w-lg leading-relaxed font-light\">\n                    Experience the future of financial management. Real-time insights, instant transfers, and zero hidden fees. Designed for the builders of tomorrow.\n                </p>\n\n                <div class=\"fade-in-up delay-300 flex flex-col sm:flex-row items-start sm:items-center gap-4\">\n                    <button class=\"btn-shine btn-bounce group relative px-6 py-3 bg-white text-black rounded-full font-medium text-sm overflow-hidden transition-all hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:pr-8\">\n                        <span class=\"relative z-10\">Start for free</span>\n                        <span class=\"iconify absolute right-2.5 top-1/2 -translate-y-1/2 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\" data-icon=\"lucide:arrow-right\"></span>\n                    </button>\n                    \n                    <button class=\"btn-bounce px-6 py-3 text-zinc-300 hover:text-white flex items-center gap-2 text-sm font-medium transition-colors group\">\n                        <span class=\"iconify group-hover:scale-110 transition-transform duration-300 text-indigo-400\" data-icon=\"lucide:play-circle\" data-width=\"18\"></span>\n                        Watch Showreel\n                    </button>\n                </div>\n                \n                <div class=\"fade-in-up delay-300 pt-8 flex items-center gap-6 text-zinc-500\">\n                    <div class=\"flex items-center gap-2 hover:text-zinc-300 transition-colors cursor-default\">\n                        <span class=\"iconify\" data-icon=\"lucide:shield-check\"></span>\n                        <span class=\"text-xs\">FDIC Insured</span>\n                    </div>\n                    <div class=\"flex items-center gap-2 hover:text-zinc-300 transition-colors cursor-default\">\n                        <span class=\"iconify\" data-icon=\"lucide:zap\"></span>\n                        <span class=\"text-xs\">Instant Setup</span>\n                    </div>\n                    <div class=\"flex items-center gap-2 hover:text-zinc-300 transition-colors cursor-default\">\n                        <span class=\"iconify\" data-icon=\"lucide:globe\"></span>\n                        <span class=\"text-xs\">Global Access</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Right Column: 3D Card -->\n            <div class=\"relative h-[400px] sm:h-[500px] flex items-center justify-center fade-in-up delay-200 lg:justify-end\">\n                <div id=\"cardContainer\" class=\"card-container group relative w-full max-w-sm sm:max-w-md aspect-[1.586/1] z-10 cursor-pointer\">\n                    \n                    <div id=\"card3d\" class=\"card-3d relative w-full h-full rounded-2xl will-change-transform\">\n                        \n                        <div class=\"absolute inset-0 rounded-2xl bg-indigo-900/80 layer-depth-1 border border-white/5 pointer-events-none\"></div>\n                        <div class=\"absolute inset-0 rounded-2xl bg-indigo-950/80 layer-depth-2 border border-white/5 pointer-events-none\"></div>\n                        <div class=\"absolute inset-0 rounded-2xl bg-indigo-950/80 layer-depth-3 border border-white/5 pointer-events-none\"></div>\n                        <div class=\"absolute inset-0 rounded-2xl bg-indigo-950/80 layer-depth-4 border border-white/5 pointer-events-none\"></div>\n                        <div class=\"absolute inset-0 rounded-2xl bg-black/50 layer-depth-5 shadow-2xl pointer-events-none\"></div>\n\n                        <div class=\"absolute inset-0 rounded-2xl epic-gradient glass-panel overflow-hidden\">\n                            \n                            <div class=\"absolute inset-0 opacity-20 mix-blend-overlay pointer-events-none\" style=\"background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22 opacity=%221%22/%3E%3C/svg%3E');\"></div>\n                            \n                            <div class=\"absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-black/20 pointer-events-none\"></div>\n                            \n                            <div id=\"cardGlare\" class=\"absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent opacity-0 pointer-events-none transition-opacity duration-300\"></div>\n\n                            <div class=\"relative h-full flex flex-col justify-between p-6 sm:p-8 z-10 pointer-events-none\">\n                                \n                                <div class=\"flex justify-between items-start\">\n                                    <div class=\"flex items-center gap-2 text-white/90\">\n                                        <div class=\"w-8 h-8 rounded-full border border-white/20 flex items-center justify-center bg-white/5 backdrop-blur-sm\">\n                                            <span class=\"font-semibold text-lg tracking-tighter\">N</span>\n                                        </div>\n                                        <span class=\"text-sm font-medium tracking-wide uppercase opacity-80\">Nova</span>\n                                    </div>\n                                    <span class=\"iconify text-white/60\" data-icon=\"lucide:nfc\" data-width=\"28\" style=\"stroke-width: 1.5;\"></span>\n                                </div>\n\n                                <div class=\"flex flex-col gap-6 mt-2\">\n                                    <div class=\"w-12 h-9 rounded-md chip relative border border-white/20 shadow-sm flex items-center justify-center overflow-hidden\">\n                                        <div class=\"absolute inset-0 border border-black/10 rounded-md\"></div>\n                                        <div class=\"absolute w-[1px] h-full bg-black/10 left-1/3\"></div>\n                                        <div class=\"absolute w-[1px] h-full bg-black/10 right-1/3\"></div>\n                                        <div class=\"absolute h-[1px] w-full bg-black/10 top-1/2\"></div>\n                                        <div class=\"absolute w-6 h-4 border border-black/10 rounded-sm\"></div>\n                                    </div>\n                                    \n                                    <div class=\"flex justify-between items-center w-full max-w-[90%]\">\n                                        <span class=\"text-lg sm:text-2xl font-mono-card text-white/90 tracking-widest drop-shadow-md\">4242</span>\n                                        <span class=\"text-lg sm:text-2xl font-mono-card text-white/90 tracking-widest drop-shadow-md\">9911</span>\n                                        <span class=\"text-lg sm:text-2xl font-mono-card text-white/90 tracking-widest drop-shadow-md\">6224</span>\n                                        <span class=\"text-lg sm:text-2xl font-mono-card text-white/90 tracking-widest drop-shadow-md\">1085</span>\n                                    </div>\n                                </div>\n\n                                <div class=\"flex justify-between items-end\">\n                                    <div class=\"flex flex-col\">\n                                        <span class=\"text-[10px] uppercase tracking-widest text-white/50 mb-1 font-medium\">Cardholder</span>\n                                        <span class=\"text-sm sm:text-base font-medium text-white tracking-wide uppercase\">Jordan Rivers</span>\n                                    </div>\n                                    \n                                    <div class=\"flex flex-col items-end\">\n                                        <span class=\"text-[10px] uppercase tracking-widest text-white/50 mb-1 font-medium\">Expires</span>\n                                        <span class=\"text-sm sm:text-base font-mono-card text-white tracking-wide\">09/28</span>\n                                    </div>\n                                    \n                                    <div class=\"relative flex items-center ml-4\">\n                                        <div class=\"w-8 h-8 rounded-full bg-red-500/80 backdrop-blur-sm mix-blend-screen z-10\"></div>\n                                        <div class=\"w-8 h-8 rounded-full bg-orange-400/80 backdrop-blur-sm -ml-4 z-0\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div id=\"cardShadow\" class=\"absolute -bottom-16 left-1/2 -translate-x-1/2 w-[90%] h-8 bg-black/40 blur-xl rounded-[100%] transition-all duration-500 opacity-40\"></div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Features Grid -->\n        <div class=\"max-w-7xl mx-auto px-6 mt-12 mb-20 relative z-10\">\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- Feature 1 -->\n                <div class=\"reveal-on-scroll stagger-1 group p-6 rounded-2xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] hover:-translate-y-1 transition-all duration-300\">\n                    <div class=\"w-10 h-10 rounded-full bg-indigo-500/10 flex items-center justify-center mb-4 text-indigo-400 group-hover:bg-indigo-500/20 group-hover:scale-110 transition-all duration-300\">\n                        <span class=\"iconify\" data-icon=\"lucide:activity\" data-width=\"20\"></span>\n                    </div>\n                    <h3 class=\"text-lg font-medium text-white mb-2\">Real-time Analytics</h3>\n                    <p class=\"text-sm text-zinc-500 leading-relaxed\">Track every transaction as it happens. Visualize spending patterns with zero latency.</p>\n                </div>\n\n                <!-- Feature 2 -->\n                <div class=\"reveal-on-scroll stagger-2 group p-6 rounded-2xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] hover:-translate-y-1 transition-all duration-300\">\n                    <div class=\"w-10 h-10 rounded-full bg-fuchsia-500/10 flex items-center justify-center mb-4 text-fuchsia-400 group-hover:bg-fuchsia-500/20 group-hover:scale-110 transition-all duration-300\">\n                        <span class=\"iconify\" data-icon=\"lucide:credit-card\" data-width=\"20\"></span>\n                    </div>\n                    <h3 class=\"text-lg font-medium text-white mb-2\">Virtual Cards</h3>\n                    <p class=\"text-sm text-zinc-500 leading-relaxed\">Create unlimited virtual cards for specific vendors. Set limits and freeze instantly.</p>\n                </div>\n\n                <!-- Feature 3 -->\n                <div class=\"reveal-on-scroll stagger-3 group p-6 rounded-2xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] hover:-translate-y-1 transition-all duration-300\">\n                    <div class=\"w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center mb-4 text-emerald-400 group-hover:bg-emerald-500/20 group-hover:scale-110 transition-all duration-300\">\n                        <span class=\"iconify\" data-icon=\"lucide:lock\" data-width=\"20\"></span>\n                    </div>\n                    <h3 class=\"text-lg font-medium text-white mb-2\">Ironclad Security</h3>\n                    <p class=\"text-sm text-zinc-500 leading-relaxed\">Bank-grade encryption with biometric authentication standard on all accounts.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Testimonials Section -->\n        <div class=\"w-full relative py-20 border-t border-white/5 bg-white/[0.005]\">\n            <div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/10 via-transparent to-transparent pointer-events-none\"></div>\n            \n            <div class=\"max-w-7xl mx-auto px-6 relative z-10\">\n                <div class=\"reveal-on-scroll flex flex-col items-center text-center mb-16\">\n                    <h2 class=\"text-3xl font-semibold tracking-tight text-white mb-4\">Trusted by modern founders</h2>\n                    <p class=\"text-zinc-400 text-sm max-w-lg\">Join thousands of companies who trust Nova to power their financial infrastructure.</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <!-- Review 1 -->\n                    <div class=\"reveal-on-scroll stagger-1 p-6 rounded-2xl border border-white/5 bg-zinc-900/50 backdrop-blur-sm hover:border-white/10 transition-colors duration-300\">\n                        <div class=\"flex items-center gap-4 mb-4\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-xs font-medium text-white shadow-lg shadow-indigo-500/20\">AS</div>\n                            <div>\n                                <h4 class=\"text-sm font-medium text-white\">Alex Sarah</h4>\n                                <p class=\"text-xs text-zinc-500\">CEO at TechFlow</p>\n                            </div>\n                        </div>\n                        <p class=\"text-sm text-zinc-300 font-light leading-relaxed\">\"Nova completely transformed how we manage our startup's runway. The virtual cards feature alone has saved us countless hours of reconciliation.\"</p>\n                    </div>\n\n                    <!-- Review 2 -->\n                    <div class=\"reveal-on-scroll stagger-2 p-6 rounded-2xl border border-white/5 bg-zinc-900/50 backdrop-blur-sm hover:border-white/10 transition-colors duration-300\">\n                        <div class=\"flex items-center gap-4 mb-4\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-xs font-medium text-white shadow-lg shadow-emerald-500/20\">DR</div>\n                            <div>\n                                <h4 class=\"text-sm font-medium text-white\">David Ross</h4>\n                                <p class=\"text-xs text-zinc-500\">Founder at Prism</p>\n                            </div>\n                        </div>\n                        <p class=\"text-sm text-zinc-300 font-light leading-relaxed\">\"The API is a dream to work with. We built our entire internal expense dashboard on top of Nova in less than a week. Highly recommended.\"</p>\n                    </div>\n\n                    <!-- Review 3 -->\n                    <div class=\"reveal-on-scroll stagger-3 p-6 rounded-2xl border border-white/5 bg-zinc-900/50 backdrop-blur-sm hover:border-white/10 transition-colors duration-300\">\n                        <div class=\"flex items-center gap-4 mb-4\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-fuchsia-500 to-pink-600 flex items-center justify-center text-xs font-medium text-white shadow-lg shadow-fuchsia-500/20\">EM</div>\n                            <div>\n                                <h4 class=\"text-sm font-medium text-white\">Elena M.</h4>\n                                <p class=\"text-xs text-zinc-500\">CTO at Vertex</p>\n                            </div>\n                        </div>\n                        <p class=\"text-sm text-zinc-300 font-light leading-relaxed\">\"Finally, a banking interface that doesn't look like it was built in 1999. It's fast, beautiful, and the customer support is incredible.\"</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Pricing Section -->\n        <div class=\"w-full relative py-20 border-t border-white/5\">\n            <div class=\"max-w-7xl mx-auto px-6\">\n                \n                <div class=\"reveal-on-scroll flex flex-col items-center text-center mb-16\">\n                    <h2 class=\"text-3xl font-semibold tracking-tight text-white mb-4\">Simple, transparent pricing</h2>\n                    <p class=\"text-zinc-400 text-sm max-w-lg mb-8\">Start for free, scale as you grow. No hidden transaction fees.</p>\n                    \n                    <!-- Custom Toggle -->\n                    <div class=\"flex items-center gap-3 bg-zinc-900 border border-white/5 p-1 rounded-full relative\">\n                        <div class=\"w-[1px] h-4 bg-white/10 mx-auto absolute left-1/2 top-1/2 -translate-y-1/2 -translate-x-1/2 z-0\"></div>\n                        <button id=\"monthlyBtn\" class=\"relative z-10 px-4 py-1.5 rounded-full text-xs font-medium text-white bg-zinc-800 shadow-sm transition-all duration-300 hover:scale-105 active:scale-95\">Monthly</button>\n                        <button id=\"yearlyBtn\" class=\"relative z-10 px-4 py-1.5 rounded-full text-xs font-medium text-zinc-500 hover:text-white transition-all duration-300 hover:scale-105 active:scale-95\">Yearly</button>\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 items-start\">\n                    \n                    <!-- Starter Plan -->\n                    <div class=\"reveal-on-scroll stagger-1 p-8 rounded-3xl border border-white/10 bg-black/20 hover:border-white/20 hover:bg-white/[0.03] transition-all duration-500 group\">\n                        <h3 class=\"text-sm font-medium text-zinc-400 mb-2 group-hover:text-white transition-colors\">Starter</h3>\n                        <div class=\"flex items-baseline gap-1 mb-6\">\n                            <span class=\"text-3xl font-semibold text-white tracking-tight\">$0</span>\n                            <span class=\"text-sm text-zinc-500\">/mo</span>\n                        </div>\n                        <ul class=\"space-y-4 mb-8\">\n                            <li class=\"flex items-center gap-3 text-sm text-zinc-300\">\n                                <span class=\"iconify text-zinc-500 group-hover:text-zinc-300 transition-colors\" data-icon=\"lucide:check\" data-width=\"16\"></span>\n                                2 Virtual Cards\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-zinc-300\">\n                                <span class=\"iconify text-zinc-500 group-hover:text-zinc-300 transition-colors\" data-icon=\"lucide:check\" data-width=\"16\"></span>\n                                $5k Monthly Limit\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-zinc-300\">\n                                <span class=\"iconify text-zinc-500 group-hover:text-zinc-300 transition-c