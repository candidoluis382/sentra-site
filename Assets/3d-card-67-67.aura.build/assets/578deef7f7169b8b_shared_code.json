md:text-sm font-medium text-zinc-300\" data-key=\"h\">H</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\"j\">J</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\"k\">K</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\"l\">L</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\";\">;</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\"'\">'</div>\n                        <div class=\"key w-16 md:w-20 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-[10px] md:text-xs font-medium text-indigo-400\" data-key=\"enter\">ENTER</div>\n                    </div>\n\n                    <!-- Row 4 -->\n                    <div class=\"flex gap-1 md:gap-2 justify-center\">\n                        <div class=\"key w-24 md:w-28 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-[10px] md:text-xs font-medium text-zinc-400\" data-key=\"shift\">SHIFT</div>\n                        <div class=\"key w-10 md:w-14 h-10 md:h-14 rounded bg-zinc-900 border border-zinc-700 flex items-center justify-center text-xs md:text-sm font-medium text-zinc-300\" data-key=\"z\">Z</div>\n                        <div class=\"key w-10 md:w-14 h-10 md